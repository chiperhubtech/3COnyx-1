{
 "Resources": {
  "RunnerTracker": {
   "Type": "AWS::Location::Tracker",
   "Properties": {
    "Description": "3C Onyx runner GPS tracker with accuracy-based position filtering",
    "PositionFiltering": "AccuracyBased",
    "Tags": [
     {
      "Key": "managed-by",
      "Value": "cdk"
     },
     {
      "Key": "project",
      "Value": "3c-onyx"
     }
    ],
    "TrackerName": "3c-onyx-runner-tracker"
   },
   "Metadata": {
    "aws:cdk:path": "OnyxCompute/RunnerTracker"
   }
  },
  "CDKMetadata": {
   "Type": "AWS::CDK::Metadata",
   "Properties": {
    "Analytics": "v2:deflate64:H4sIAAAAAAAA/zPSMzIx1TNQTCwv1k1OydbNyUzSqw4uSUzO1gEKxefkJyeWZObn6Tmn5YUUAUVTi3SATP/SkoLSklqdvPyUVL2sYv0yIxM9Q2OgMVnFmZm6RaV5JZm5qXpBEBoAfIOTKmMAAAA="
   },
   "Metadata": {
    "aws:cdk:path": "OnyxCompute/CDKMetadata/Default"
   }
  }
 },
 "Outputs": {
  "TrackerName": {
   "Description": "Location Service tracker name for runner GPS tracking",
   "Value": "3c-onyx-runner-tracker",
   "Export": {
    "Name": "OnyxRunnerTrackerName"
   }
  },
  "TrackerArn": {
   "Description": "Location Service tracker ARN",
   "Value": {
    "Fn::GetAtt": [
     "RunnerTracker",
     "Arn"
    ]
   },
   "Export": {
    "Name": "OnyxRunnerTrackerArn"
   }
  }
 },
 "Parameters": {
  "BootstrapVersion": {
   "Type": "AWS::SSM::Parameter::Value<String>",
   "Default": "/cdk-bootstrap/hnb659fds/version",
   "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]"
  }
 },
 "Rules": {
  "CheckBootstrapVersion": {
   "Assertions": [
    {
     "Assert": {
      "Fn::Not": [
       {
        "Fn::Contains": [
         [
          "1",
          "2",
          "3",
          "4",
          "5"
         ],
         {
          "Ref": "BootstrapVersion"
         }
        ]
       }
      ]
     },
     "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI."
    }
   ]
  }
 }
}