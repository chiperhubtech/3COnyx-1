  "ComputeFeeFnAC898F99": {
   "Type": "AWS::Lambda::Function",
   "Properties": {
    "Code": {
     "ZipFile": "\n        exports.handler = async (event) => {\n          const commissionUsd = Number(event.commissionUsd) || 0;\n          const dynastyFeeUsd = Math.round((commissionUsd / 3) * 100) / 100;\n          return { ...event, dynastyFeeUsd };\n        };\n      "
    },
    "Description": "Compute dynasty fee as commissionUsd / 3",
    "FunctionName": "3c-onyx-compute-dynasty-fee",
    "Handler": "index.handler",
    "MemorySize": 128,
    "Role": {
     "Fn::GetAtt": [
      "ComputeFeeFnServiceRoleB7A4FEFE",
      "Arn"
     ]
    },
    "Runtime": "nodejs20.x",
    "Tags": [
     {
      "Key": "managed-by",
      "Value": "cdk"
     },
     {
      "Key": "project",
      "Value": "3c-onyx"
     }
    ],
    "Timeout": 10
   },
   "DependsOn": [
    "ComputeFeeFnServiceRoleB7A4FEFE"
   ],
