     "Fn::Join": [
      "",
      [
       "{\"StartAt\":\"ComputeDynastyFee\",\"States\":{\"ComputeDynastyFee\":{\"Next\":\"EmitDynastyFeeEarned\",\"Retry\":[{\"ErrorEquals\":[\"Lambda.ClientExecutionTimeoutException\",\"Lambda.ServiceException\",\"Lambda.AWSLambdaException\",\"Lambda.SdkClientException\"],\"IntervalSeconds\":2,\"MaxAttempts\":6,\"BackoffRate\":2}],\"Type\":\"Task\",\"Comment\":\"DealStructured → compute fee (commissionUsd × 1/3)\",\"OutputPath\":\"$.Payload\",\"Resource\":\"arn:",
       {
        "Ref": "AWS::Partition"
       },
       ":states:::lambda:invoke\",\"Parameters\":{\"FunctionName\":\"",
       {
        "Fn::GetAtt": [
         "ComputeFeeFnAC898F99",
         "Arn"
        ]
       },
       "\",\"Payload.$\":\"$\"}},\"EmitDynastyFeeEarned\":{\"Next\":\"SettleReferralLedger\",\"Type\":\"Task\",\"ResultPath\":\"$.eventResult\",\"Resource\":\"arn:",
       {
        "Ref": "AWS::Partition"
       },
       ":states:::events:putEvents\",\"Parameters\":{\"Entries\":[{\"Detail\":{\"dealId.$\":\"$.dealId\",\"commissionUsd.$\":\"$.commissionUsd\",\"dynastyFeeUsd.$\":\"$.dynastyFeeUsd\",\"referrerId.$\":\"$.referrerId\",\"agentId.$\":\"$.agentId\",\"ts.$\":\"$.ts\"},\"DetailType\":\"payment.dynasty_fee.earned\",\"EventBusName\":\"arn:",
       {
        "Ref": "AWS::Partition"
       },
       ":events:us-east-1:",
       {
        "Ref": "AWS::AccountId"
       },
       ":event-bus/3c-onyx-event-bus\",\"Source\":\"3c-onyx-workflow\"}]}},\"SettleReferralLedger\":{\"Next\":\"Done\",\"Type\":\"Task\",\"ResultPath\":\"$.settleResult\",\"Resource\":\"arn:",
       {
        "Ref": "AWS::Partition"
       },
       ":states:::events:putEvents\",\"Parameters\":{\"Entries\":[{\"Detail\":{\"dealId.$\":\"$.dealId\",\"dynastyFeeUsd.$\":\"$.dynastyFeeUsd\",\"referrerId.$\":\"$.referrerId\",\"action\":\"settle\",\"ts.$\":\"$.ts\"},\"DetailType\":\"referral.settled\",\"EventBusName\":\"arn:",
