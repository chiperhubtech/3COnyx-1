# ─────────────────────────────────────────────────────────────────────────────
# 3C Onyx — Web Frontend (Vite/React SPA served by Nginx)
#
# AWS CloudFront + S3 alternative:
#   1. docker build -f Dockerfile.web --build-arg BASE_PATH=/ -t 3c-onyx-web .
#   2. docker run -p 80:80 -e API_URL=https://api.3conyx.com 3c-onyx-web
#
# Or copy dist/public/ directly to an S3 bucket behind CloudFront.
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

ARG BASE_PATH=/
ENV BASE_PATH=${BASE_PATH}

WORKDIR /workspace

RUN corepack enable && corepack prepare pnpm@9 --activate

COPY package.json pnpm-workspace.yaml ./
COPY pnpm-lock.yaml ./
COPY lib/ ./lib/
COPY artifacts/3c-onyx/ ./artifacts/3c-onyx/

RUN pnpm install --frozen-lockfile --ignore-scripts

RUN pnpm --filter @workspace/3c-onyx run build

# ── Stage 2: Nginx ────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runner

# Copy Nginx config
COPY nginx.conf /etc/nginx/nginx.conf

# Copy built SPA
COPY --from=builder /workspace/artifacts/3c-onyx/dist/public /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
