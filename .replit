modules = ["nodejs-24", "postgresql-16", "python-base-3.13"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "build-api"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "build-web"

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck 2>&1 | tail -20"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "build-api"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run build 2>&1 | tail -10"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "build-web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/3c-onyx run build 2>&1 | tail -10"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
NAMECHEAP_API_USER = "Ron3c"
NAMECHEAP_CLIENT_IP = "34.23.128.152"
SMARTCAR_APPLICATION_ID = "39e525a7-8330-4ecb-8d1d-f71c437988a2"

[userenv.development]
SMARTCAR_REDIRECT_URI = "https://eb25d043-cc07-434a-b5ec-445156034c51-00-1s66novwliksy.worf.replit.dev/api/garage/callback"

[userenv.production]
SMARTCAR_REDIRECT_URI = "https://3conyx.ai/api/garage/callback"
