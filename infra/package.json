{
  "name": "@workspace/infra",
  "version": "1.0.0",
  "description": "3C Onyx — AWS CDK Infrastructure (Agentic OS, Scale to 1M users)",
  "private": true,
  "scripts": {
    "build":   "tsc --noEmit",
    "synth":   "cdk synth",
    "deploy":  "cdk deploy --all --require-approval never",
    "diff":    "cdk diff",
    "destroy": "cdk destroy --all",
    "lint":    "eslint 'lib/**/*.ts' 'bin/**/*.ts'"
  },
  "dependencies": {
    "aws-cdk-lib":        "^2.140.0",
    "constructs":         "^10.3.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "aws-cdk":            "^2.140.0",
    "typescript":         "^5.4.0",
    "@types/node":        "^20.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
