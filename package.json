{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "@types/pdfkit": "^0.17.5",
    "prettier": "^3.8.1",
    "tsx": "catalog:",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1019.0",
    "@aws-sdk/client-eventbridge": "^3.1019.0",
    "@aws-sdk/client-location": "^3.1159.0",
    "@aws-sdk/client-rekognition": "^3.1019.0",
    "@aws-sdk/client-secrets-manager": "^3.1019.0",
    "@google/genai": "^1.46.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@opensearch-project/opensearch": "^3.5.1",
    "@types/multer": "^2.1.0",
    "multer": "^2.1.1",
    "pdfkit": "^0.18.0",
    "stripe": "^20.4.1",
    "stripe-replit-sync": "^1.0.0"
  }
}
