# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║          3C ONYX — PRODUCTION ENVIRONMENT VARIABLES                         ║
# ║          Copy this file to .env and fill in real values before deploy       ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ─── Database ─────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string (managed automatically by Replit in dev)
DATABASE_URL=postgres://user:password@host:5432/3c_onyx

# ─── Authentication ───────────────────────────────────────────────────────────
# Must be ≥32 random characters — generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET_MIN_32_CHARS

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Webhook secret from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# Public key for frontend
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ─── Google AI (Gemini) ───────────────────────────────────────────────────────
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIza...

# ─── MarketCheck (Vehicle Data) ───────────────────────────────────────────────
# Get from: https://www.marketcheck.com/
MARKETCHECK_API_KEY=mc_...

# ─── Checkr (Background Checks) ───────────────────────────────────────────────
# Get from: https://checkr.com/
CHECKR_API_KEY=...
CHECKR_WEBHOOK_SECRET=...

# ─── Smartcar (Vehicle Telematics) ────────────────────────────────────────────
# Get from: https://smartcar.com/
SMARTCAR_CLIENT_ID=...
SMARTCAR_CLIENT_SECRET=...
SMARTCAR_REDIRECT_URI=https://app.3conyx.com/api/smartcar/callback

# ─── HyperTrack (Logistics Tracking) ─────────────────────────────────────────
# Get from: https://hypertrack.com/
HYPERTRACK_ACCOUNT_ID=...
HYPERTRACK_SECRET_KEY=...

# ─── Browserbase (Web Automation) ────────────────────────────────────────────
# Get from: https://browserbase.com/
BROWSERBASE_API_KEY=...
BROWSERBASE_PROJECT_ID=...

# ─── Email (Transactional) ────────────────────────────────────────────────────
# Recommended: Resend or SendGrid
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@3conyx.com

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins in production
ALLOWED_ORIGINS=https://app.3conyx.com,https://www.3conyx.com

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080

# ─── AWS / Deployment ─────────────────────────────────────────────────────────
# Used when deploying to AWS ECS/EC2
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
ECR_REPOSITORY=3c-onyx-api

# ─── Monitoring (Optional) ────────────────────────────────────────────────────
# SENTRY_DSN=https://...@sentry.io/...
# DATADOG_API_KEY=...

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Set to "true" to enable features globally
ENABLE_WAITLIST=true
ENABLE_BLOCKCHAIN=true
ENABLE_AR_VIEWER=true
